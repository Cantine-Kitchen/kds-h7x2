  "recipes": [
    {
      "name": "Caesar Dressing",
      "category": "Sauces & Condiments",
      "ingredients": "1 1/2 cup Kalamata Olives, minced\n2 medium Shallots\n1/2 cup Parmesan\n2 tsp Garlic\nPinch Herbs\nSalt and Pepper\n1 cup Red Vinegar\n3 quarts Mayo\n1/4 cup Dijon Mustard",
      "method": "1. Blend olives in Robo Coupe until paste forms.\n2. Add shallots, parmesan, garlic, herbs, and salt & pepper. Blend.\n3. Add vinegar, mayo, and dijon mustard. Blend until smooth.\n4. Date and store in squeeze bottles.",
      "notes": "Yield: 4 Quarts | Shelf Life: 7 Days"
    },
    {
      "name": "Calamari Build",
      "category": "Prep & Pantry",
      "ingredients": "1 cup Calamari (drained)\n1/2 cup Seasoned Flour\nSalt & Pepper\n2 tbsp Citrus Aioli\n1 tbsp Tomato Relish\nFresh Herb Mix",
      "method": "1. Place 1 even cup drained calamari in flour mix. Coat well.\n2. Fry 45 seconds to 1 min until crispy golden brown.\n3. Toss in mixing bowl with salt & pepper.\n4. Place in bowl, drizzle with aioli and top with tomato relish and herbs.",
      "notes": "Serve ASAP hot out of fryer"
    },
    {
      "name": "Confit Wings",
      "category": "Prep & Pantry",
      "ingredients": "40 lb Chicken Wings\n8 qt Chicken Fat (melted)\n1 qt Kosher Salt\n1 qt Brown Sugar\n1/2 cup Chili Flakes",
      "method": "1. Toss chicken wings in cure (salt, sugar, chili flakes).\n2. Cure overnight (max 2 days).\n3. Melt fat in rondeau, submerge wings, simmer on low heat for 2 hours.\n4. Cool wings on sheet trays. Flash fry 3 minutes for service.",
      "notes": "Yield: 40 lb | Shelf Life: 1 Week"
    },
    {
      "name": "Bacon Aioli",
      "category": "Sauces & Condiments",
      "ingredients": "2 cups Rendered Bacon Fat (cooled)\n2 qt Heavy Mayo\n1/4 cup Roasted Garlic Paste\n2 tbsp Smoked Paprika\n1 tbsp Apple Cider Vinegar\nSalt & Black Pepper",
      "method": "1. Whisk mayo and roasted garlic paste in large stainless bowl.\n2. Slowly drizzle in cooled rendered bacon fat while whisking briskly to emulsify.\n3. Add paprika, vinegar, salt, and pepper.\n4. Transfer to cambros, label with day dot.",
      "notes": "Keep refrigerated below 38°F"
    },
    {
      "name": "Grilled Cheese Comte Build",
      "category": "Grill Station",
      "ingredients": "2 slices Stone Oven Pugliese\n3 oz Comte Cheese (shredded)\n1 tbsp Garlic Butter\n1 tbsp Pear Mostarda",
      "method": "1. Spread garlic butter on outside of both bread slices.\n2. Layer Comte cheese and pear mostarda inside.\n3. Toast on flat top grill over medium-low heat until cheese is melted and crust is golden brown.\n4. Slice diagonally and serve.",
      "notes": "Check grill surface temp before firing"
    }
  ],
